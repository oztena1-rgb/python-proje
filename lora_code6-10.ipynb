    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "data=pd.read_excel(\"beam.csv.xlsx\")\n",
    "\n",
    "fig, ax=plt.subplots(figsize=(8,3))\n",
    "ax.plot(data[\"x\"], data[\"M1\"], label=\"M1\", linewidth=3)\n",
    "ax.fill_between(data[\"x\"], data[\"y1\"], color=\"lightblue\", alpha=0.5)\n",
    "\n",
    "ax.legend()\n",
    "ax.grid(True)"
   ]
  }
