   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Read the Excel file\n",
    "data = pd.read_excel(\"beam.csv.xlsx\")\n",
    "\n",
    "fig, ax=plt.subplots(figsize=(8,3))\n",
    "\n",
    "ax.invert_yaxis()\n",
    "\n",
    "ax.plot(data[\"x\"],data[\"M1\"],label=\"M1\", color=\"deeppink\", linestyle=\"--\", linewidth=3)\n",
    "ax.legend()\n",
    "plt.show()\n"
   ]
  }
