   "source": [
    "import sympy as sp\n",
    "x=sp.symbols(\"x\")\n",
    "expr=x**2+sp.Rational(1,2)*x-5\n",
    "display(expr)\n",
    "derivative=sp.diff(expr,x)\n",
    "display(derivative)\n",
    "integral1=sp.integrate(expr,x)\n",
    "display(integral1)\n",
    "integral2=sp.integrate(expr,(x, 0, 3))\n",
    "display(integral2)\n"
   ]
  }
 ],
