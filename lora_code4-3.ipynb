   "source": [
    "import sympy as sp\n",
    "x, y=sp.symbols(\"x y\")\n",
    "f=x**2+y**2+sp.Rational(1,3)*x*y\n",
    "display(f)\n",
    "res1=f.subs(x,1)\n",
    "display(res1)\n",
    "res2=f.subs([(x,1), (y,5)])\n",
    "display(res2)\n",
    "display(res2.evalf(5))"
   ]
  }
 ],
