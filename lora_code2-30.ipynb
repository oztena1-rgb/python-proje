    "def myFunc(radius, perimeter=False):\n",
    "    if perimeter == False:\n",
    "        return 3.14 * radius**2\n",
    "    else:\n",
    "        return (3.14 * radius**2, 2 * 3.14 *radius)\n",
    "    \n",
    "print(myFunc(4))\n",
    "print(myFunc(4, perimeter=True))"
   ]
  }
