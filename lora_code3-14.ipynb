   "source": [
    "import numpy as np\n",
    "l=5 #m\n",
    "q=20 #kN/m\n",
    "x=np.linspace(0,l,20)\n",
    "\n",
    "M=(q/2)*(l*x-x**2)\n",
    "V=q*(l/2-x)\n",
    "\n",
    "print(M)\n",
    "\n",
    "from matplotlib import pyplot as plt\n",
    "plt.figure(figsize=(10,4))\n",
    "plt.plot([0]*len(x), color='k')\n",
    "plt.plot(-M)\n",
    "plt.plot(V)"
   ]
  }
 ],
