   "source": [
    "import sympy as sp\n",
    "x, y=sp.symbols(\"x y\")\n",
    "res1=sp.linsolve([x+y-4, x-y-9], (x, y))\n",
    "display(res1.args[0])\n",
    "\n",
    "res2=sp.nonlinsolve([2*x**2+3*x-y-1, 3*x+2*y-5],(x,y))\n",
    "display(res2)"
   ]
  }
